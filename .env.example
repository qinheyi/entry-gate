# MiniMax (China site, OpenAI-compatible). Leave empty to use deterministic checklist scoring only.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
# MiniMax-M3 runs with thinking disabled unless this is "adaptive".
MINIMAX_THINKING=

# Optional: enable LLM narration (default on when MINIMAX_API_KEY is set). Set to 0 to force deterministic mode.
ENTRY_GATE_LLM=1
LLM_TIMEOUT_MS=60000
